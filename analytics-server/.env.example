# Copy to .env on the server and set real values (this file is committed; .env is not).
ANALYTICS_PORT=3056

# Dashboard login (aaziko.com/live-stats)
ANALYTICS_USER=aaziko
ANALYTICS_PASS=change-me-to-a-strong-password

# Stable secret so IP hashes survive restarts (any long random string)
ANALYTICS_SALT=change-me-to-a-long-random-string

# Data retention — auto-delete events (visit detail + stored responses) older than
# this many days, swept daily. Rolling window. Set 0 to keep everything forever.
RETENTION_DAYS=45

# ── Daily email digest → ceoaaziko@gmail.com ───────────────────────────────
DIGEST_ENABLED=true
DIGEST_TO=ceoaaziko@gmail.com
DIGEST_HOUR=8                 # send at 08:00 …
DIGEST_TZ_OFFSET_MIN=330      # … in this timezone (330 = IST). Used for "yesterday" too.
SITE_URL=https://aaziko.com

# SMTP — reuse the contact@aaziko.com Gmail app-password (same box's contact-mailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@aaziko.com
SMTP_PASS=your-16-char-gmail-app-password
DIGEST_FROM="Aaziko Live" <contact@aaziko.com>
